# Notion API credentials (server-side, used by /api functions)
# Create an integration at https://www.notion.so/my-integrations and copy its
# "Internal Integration Secret" here.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The ID of the Notion database that stores your meals.
# Open your database as a full page; the ID is the 32-char string in the URL:
# https://www.notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated allow-list of Telegram user IDs permitted to use the API
# (server-side enforcement). Find your ID via @userinfobot. REQUIRED.
ALLOWED_TELEGRAM_ID=1695096396

# (Optional) Telegram bot token. If set, the API also cryptographically verifies
# the Telegram initData signature so user ids cannot be forged. Get it from
# @BotFather. The app works without it; setting it is recommended hardening.
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
